def decorador(simbolo):
    def decorar(funcion):
        def funcion_decorada(a, b):
            global parentesis

            resultado = funcion(a, b)

            print(f"{parentesis} {simbolo} {b} = {resultado}")
            parentesis = f"({parentesis} {simbolo} {b})"

            return resultado

        return funcion_decorada
    return decorar

@decorador("+")
def suma(a,b):
    return a + b

@decorador("-")
def resta(a,b):
    return a - b

@decorador("*")
def multiplicacion(a,b):
    return a * b

@decorador("/")
def division(a,b):
    return a / b

