x1 = float(input('Introduce el primer valor: '))
parentesis = str(x1)

historial = []

def decorador(simbolo):
    def decorar(funcion):
        def funcion_decorada(a, b):
            global parentesis

            resultado = funcion(a, b)

            print(f"{parentesis} {simbolo} {b} = {resultado}")
            parentesis = f"({parentesis} {simbolo} {b})"

            return resultado

        return funcion_decorada
    return decorar

@decorador("+")
def suma(a,b):
    resultado = a + b
    return resultado

@decorador("+")
def resta(a,b):
    resultado = a - b
    return resultado

@decorador("+")
def multiplicacion(a,b):
    resultado = a * b
    return resultado

@decorador("+")
def division(a,b):
    resultado = a / b
    return resultado

