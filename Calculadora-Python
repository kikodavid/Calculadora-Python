def medir_tiempo(funcion):
    def funcion_decorada(a, b):
        inicio = time.time()

        resultado = funcion(a, b)

        fin = time.time()
        tiempo_transcurrido = fin - inicio
        print("Función tardó {} segundos en ejecutarse".format(tiempo_transcurrido))

        return resultado

    return funcion_decorada


